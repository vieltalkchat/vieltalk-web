{
  "name": "vieltalk-chat-web",
  "version": "0.0.0-alpha-0",
  "private": true,
  "scripts": {
    "dev": "npx genversion -f --template versioning-template.ejs src/lib/version.ts && next dev --turbo",
    "build": "npx genversion -f --template versioning-template.ejs src/lib/version.ts && next build",
    "clean": "rm -rf .next node_modules && rm -f package-lock.json yarn.lock pnpm-lock.yaml",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "genversion": "^3.2.0",
    "lucide-react": "^0.536.0",
    "next": "15.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5"
  }
}
